{
  "contract_version": "atlas.cortex.replay_evaluation_harness_contract.v1",
  "report_schema": "atlas.cortex.replay_evaluation_report.v1",
  "case_schema": "atlas.cortex.replay_case.v1",
  "adapter_schema": "atlas.cortex.external_adapter_candidate.v1",
  "rubric_schema": "atlas.cortex.replay_evaluation_rubric.v1",
  "mode": "deterministic_offline_advisory_comparison",
  "runtime_adoption": "not_implemented",
  "required_inputs": [
    "replay_case",
    "external_adapter_candidate",
    "cortex_chat_style_synthesis_packet",
    "cortex_execution_plan",
    "evaluation_rubric"
  ],
  "admitted_source_schemas": [
    "atlas.cortex.replay_case.v1",
    "atlas.cortex.external_adapter_candidate.v1",
    "atlas.cortex.chat_style_synthesis_packet.v1",
    "atlas.cortex.execution_plan.v1",
    "atlas.cortex.replay_evaluation_rubric.v1"
  ],
  "comparison_dimensions": [
    "schema_compatibility",
    "source_digest_parity",
    "objective_and_selected_scope",
    "project_component_repository_owner",
    "execution_class",
    "scope_lock",
    "dependency_graph",
    "resource_claims",
    "runtime_recommendation",
    "permission_capability_separation",
    "external_action_authority_and_approvals",
    "verification_proof_commit_and_receipt_requirements",
    "rollback_and_recovery_requirements",
    "blocker_conflict_warning_and_admission_posture",
    "repeated_output_stability"
  ],
  "result_classes": [
    "equivalent",
    "cortex_stricter",
    "adapter_stricter",
    "complementary",
    "regression",
    "incomparable",
    "blocked"
  ],
  "report_fields": [
    "schema_version",
    "report_id",
    "case_id",
    "source_digests",
    "source_trust_classes",
    "comparator_version",
    "rubric_version",
    "adapter_projection",
    "cortex_projection",
    "field_comparisons",
    "matched_constraints",
    "adapter_only_constraints",
    "cortex_only_constraints",
    "omissions",
    "contradictions",
    "authority_regressions",
    "dependency_and_collision_differences",
    "verification_and_receipt_differences",
    "metrics",
    "prior_report_comparison",
    "result_class",
    "explanation_codes",
    "blocked_reasons",
    "warnings",
    "skipped_reasons",
    "safe_to_use",
    "next_recommended_packet",
    "authority_denials"
  ],
  "identity_rule": "stable_digest_of_contract_case_rubric_and_normalized_input_digests",
  "ordering_rules": [
    "normalize_repository_relative_paths",
    "sort_constraints_by_dimension_then_stable_value",
    "sort_findings_by_code_then_path_then_field",
    "preserve_declared_report_field_order"
  ],
  "path_policy": {
    "inputs": ["docs/**", "tmp/atlas/**.json"],
    "outputs": ["tmp/atlas/**.json"],
    "denied": [
      "repos/**",
      "runtime/**",
      "secrets/**",
      ".env*",
      ".codex/**",
      ".vercel/**",
      "archive/**",
      "absolute_paths",
      "parent_traversal",
      "hidden_transcripts",
      "browser_profiles",
      "account_health_payment_or_personal_data",
      "live_platform_sources"
    ]
  },
  "failure_closed_conditions": [
    "missing_or_invalid_required_schema",
    "case_or_artifact_identity_mismatch",
    "conflicting_source_digest",
    "stale_or_unredacted_input",
    "missing_ownership",
    "hidden_transcript_dependence",
    "secret_bearing_or_protected_path",
    "absolute_path_or_parent_traversal",
    "unknown_rubric_version",
    "unknown_comparison_dimension",
    "self_granted_authority",
    "nondeterministic_repeated_output",
    "unadmitted_output_path"
  ],
  "authority_denials": [
    "no_execution_authority",
    "no_model_call_authority",
    "no_final_receipt_authority",
    "no_marker_authority",
    "no_routing_authority",
    "no_codex_launch",
    "no_stack_invocation",
    "no_git_authority",
    "no_deploy_authority",
    "no_discord_or_card_authority",
    "no_database_authority",
    "no_external_mutation_authority",
    "no_queue_or_scheduler_creation",
    "no_owner_repository_mutation",
    "no_live_platform_query",
    "no_hidden_transcript_or_private_reasoning_access"
  ],
  "first_implementation_boundary": {
    "allowed_paths": [
      "ops/cortex/replay_evaluation_harness.py",
      "tests/test_cortex_replay_evaluation_harness.py"
    ],
    "allowed_output_glob": "tmp/atlas/**.json",
    "forbidden_targets": [
      "existing_cortex_helpers",
      "_stack",
      "atlas_contracts",
      "playbook",
      "owner_repositories",
      "discordos",
      "cards",
      "markers",
      "runtime_state",
      "secrets",
      "workflows",
      "live_platforms"
    ]
  },
  "marker_decision": {
    "marker": "Cortex Dual-Mode Replacement Readiness",
    "percent": 60,
    "movement": "none",
    "next_packet": "Cortex Dual-Mode Replacement Readiness replay/evaluation harness first-implementation admission",
    "movement_to_70_requires": "admitted_implemented_proof_backed_reconciled_and_separately_ratcheted_replay_evaluation_harness"
  }
}
