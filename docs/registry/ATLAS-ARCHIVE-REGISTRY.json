    "canonical_patch_root": "packages/patches"
  },
  "scope_notes": [
    "This registry covers the ATLAS archive-governance tranche reviewed at the stack root.",
    "Mazer legacy zip surfaces remain tracked elsewhere and are intentionally not widened here."
