# Root control repo ignores child repos and mutable stack lanes by default.
repos/**
runtime/**
!runtime/
!runtime/atlas/
runtime/atlas/**
!runtime/atlas/context-packs/
!runtime/atlas/context-packs/.gitkeep
!runtime/cortex/
runtime/cortex/**
!runtime/cortex/kernel.state-model.seed.v1.json
!runtime/cortex/kernel.rule-registry.seed.v1.json
!runtime/cortex/kernel.proof-summary.examples.v1.json
!runtime/cortex/shadow-agent-registry.seed.v1.json
tmp/**
secrets/**
packages/**
!packages/
!packages/atlas-contracts/
!packages/atlas-contracts/**
!packages/bundles/
!packages/bundles/.gitkeep
!packages/patches/
!packages/patches/.gitkeep
!packages/patches/playbook-external-smoke-preservation-2026-05-26/
!packages/patches/playbook-external-smoke-preservation-2026-05-26/**
!packages/prebuilt/
!packages/prebuilt/.gitkeep
!packages/releases/
!packages/releases/.gitkeep
!packages/snapshots/
!packages/snapshots/.gitkeep
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep
!data/fixtures/
!data/fixtures/atlas.continuity.source.manifest.example.v1.json
!data/fixtures/atlas.playbook.adoption.report.example.v1.json
data/imports/**/raw/**
data/imports/**/extracted/**

.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.turbo/
node_modules/
dist/
build/
.next/
