{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.qa.capture_receipt.v1.json",
  "title": "ATLAS QA capture receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "scenario_id",
    "adapter_id",
    "repo_id",
    "git_sha",
    "lens_id",
    "captured_at",
    "source_url",
    "capture_backend",
    "capture_method"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.qa.capture_receipt.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "git_sha": {
      "type": "string",
      "minLength": 1
    },
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "capture_backend": {
      "type": "string",
      "minLength": 1
    },
    "capture_method": {
      "enum": [
        "browser_emulation",
        "provider_automation",
        "manual_attestation"
      ]
    }
  }
}
