{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.workflow.creation-journal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "payload_digest",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "atlas.workflow.creation-journal.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^onv1_[0-9a-f]{64}$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "no_archive",
        "supersedes_event_id",
        "entries"
      ],
      "properties": {
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "no_archive": {
          "const": true
        },
        "supersedes_event_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^onv1_[0-9a-f]{64}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "operation_key",
        "provider_idempotency_key_supported",
        "runtime_id",
        "prior_runtime_id",
        "accepted_plan_id",
        "accepted_plan_digest",
        "created_at",
        "adapter",
        "state",
        "post_apply_plan_id",
        "post_apply_plan_digest"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "operation_key": {
          "type": "string",
          "pattern": "^awci1_[0-9a-f]{64}$"
        },
        "provider_idempotency_key_supported": {
          "type": "boolean"
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prior_runtime_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "accepted_plan_id": {
          "type": "string",
          "pattern": "^awrp1_[0-9a-f]{64}$"
        },
        "accepted_plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "enum": [
            "fixture",
            "live-app-server"
          ]
        },
        "state": {
          "enum": [
            "CREATE_INTENT",
            "CREATED_PENDING_READBACK",
            "READBACK_CONFIRMED"
          ]
        },
        "post_apply_plan_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^awrp1_[0-9a-f]{64}$"
        },
        "post_apply_plan_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "CREATE_INTENT"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "runtime_id": {
                "const": null
              },
              "post_apply_plan_id": {
                "const": null
              },
              "post_apply_plan_digest": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "runtime_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "READBACK_CONFIRMED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "post_apply_plan_id": {
                "type": "string",
                "pattern": "^awrp1_[0-9a-f]{64}$"
              },
              "post_apply_plan_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "post_apply_plan_id": {
                "const": null
              },
              "post_apply_plan_digest": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}
