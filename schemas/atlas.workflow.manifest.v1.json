{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.workflow.manifest.v1",
  "title": "ATLAS Workflow Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "logical_root_role_id",
    "authority",
    "evidence_priority",
    "runtime_registry",
    "recovery_policy",
    "lifecycle_state_machines",
    "envelope_contract",
    "single_writer",
    "boot",
    "roles",
    "components",
    "edges",
    "health",
    "source_evidence"
  ],
  "properties": {
    "schema": { "const": "atlas.workflow.manifest.v1" },
    "manifest_version": { "const": 1 },
    "logical_root_role_id": { "$ref": "#/$defs/roleId" },
    "authority": { "$ref": "#/$defs/freeObject" },
    "evidence_priority": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime_registry": { "$ref": "#/$defs/freeObject" },
    "recovery_policy": { "$ref": "#/$defs/freeObject" },
    "lifecycle_state_machines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standing", "bounded"],
      "properties": {
        "standing": { "$ref": "#/$defs/stateMachine" },
        "bounded": { "$ref": "#/$defs/stateMachine" }
      }
    },
    "envelope_contract": { "$ref": "#/$defs/freeObject" },
    "single_writer": { "$ref": "#/$defs/freeObject" },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "serialization_rules"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "mode", "members", "success_gate"],
            "properties": {
              "phase": { "type": "integer", "minimum": 0 },
              "mode": { "enum": ["serial", "parallel"] },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "success_gate": { "type": "string", "minLength": 1 }
            }
          }
        },
        "serialization_rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/edge" }
    },
    "health": { "$ref": "#/$defs/freeObject" },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "roleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "freeObject": {
      "type": "object",
      "additionalProperties": true
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stateMachine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions", "terminal_states"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "gate"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "gate": { "type": "string", "minLength": 1 }
            }
          }
        },
        "terminal_states": { "$ref": "#/$defs/stringList" }
      }
    },
    "runtimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort_floor",
        "service_tier",
        "permissions",
        "approval_policy",
        "cwd_locator",
        "environment",
        "pin_required"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort_floor": { "type": "string", "minLength": 1 },
        "service_tier": { "type": "string", "minLength": 1 },
        "permissions": { "type": "string", "minLength": 1 },
        "approval_policy": { "type": "string", "minLength": 1 },
        "cwd_locator": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "pin_required": { "type": "boolean" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "human_title",
        "purpose",
        "lifecycle_class",
        "authority",
        "prohibited_actions",
        "inputs",
        "outputs",
        "dependencies",
        "upstream_routes",
        "downstream_routes",
        "source_of_truth",
        "runtime",
        "archive_policy",
        "owner",
        "health_checks",
        "wake_conditions",
        "terminal_conditions",
        "writer_scope",
        "creation_policy",
        "title_aliases",
        "prompt_template"
      ],
      "properties": {
        "role_id": { "$ref": "#/$defs/roleId" },
        "human_title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "lifecycle_class": { "enum": ["standing", "bounded"] },
        "authority": { "$ref": "#/$defs/stringList" },
        "prohibited_actions": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "dependencies": { "$ref": "#/$defs/stringList" },
        "upstream_routes": { "$ref": "#/$defs/stringList" },
        "downstream_routes": { "$ref": "#/$defs/stringList" },
        "source_of_truth": { "$ref": "#/$defs/stringList" },
        "runtime": { "$ref": "#/$defs/runtimePolicy" },
        "archive_policy": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "health_checks": { "$ref": "#/$defs/stringList" },
        "wake_conditions": { "$ref": "#/$defs/stringList" },
        "terminal_conditions": { "$ref": "#/$defs/stringList" },
        "writer_scope": { "type": ["string", "null"] },
        "creation_policy": {
          "enum": ["create_if_missing", "reuse_only", "manual_gate"]
        },
        "title_aliases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt_template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fragments", "required_markers"],
          "properties": {
            "fragments": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "required_markers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "kind",
        "purpose",
        "standing_task",
        "authority",
        "source_of_truth",
        "recovery"
      ],
      "properties": {
        "component_id": { "$ref": "#/$defs/roleId" },
        "kind": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "standing_task": { "type": "boolean" },
        "authority": { "$ref": "#/$defs/stringList" },
        "source_of_truth": { "$ref": "#/$defs/stringList" },
        "recovery": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "type", "from", "to", "contract", "runtime_binding"],
      "properties": {
        "edge_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "type": {
          "enum": ["control", "data_event", "decision", "notification", "owner", "proof", "recovery"]
        },
        "from": { "$ref": "#/$defs/roleId" },
        "to": { "$ref": "#/$defs/roleId" },
        "contract": { "type": "string", "minLength": 1 },
        "runtime_binding": { "const": "resolve-by-logical-role-at-send-time" }
      }
    }
  }
}
