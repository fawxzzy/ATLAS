{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.workflow.desktop-observation.v1",
  "title": "ATLAS Workflow Desktop Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "observation_id",
    "payload_digest",
    "payload"
  ],
  "properties": {
    "schema": { "const": "atlas.workflow.desktop-observation.v1" },
    "kind": { "const": "THREAD_STATUS_SNAPSHOT" },
    "observation_id": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" },
    "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_interface",
        "source_host_id",
        "captured_at",
        "supersession",
        "required_role_count",
        "entries"
      ],
      "properties": {
        "producer_interface": { "const": "SUPPORTED_TASK_THREAD_READBACK" },
        "source_host_id": { "const": "local" },
        "captured_at": { "type": "string", "minLength": 1 },
        "supersession": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supersedes_observation_ids"],
          "properties": {
            "supersedes_observation_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" }
            }
          }
        },
        "required_role_count": { "type": "integer", "minimum": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_id",
              "runtime_thread_id",
              "source_host_id",
              "source_title",
              "observed_at",
              "activity",
              "activity_evidence",
              "pin_state",
              "pin_capability"
            ],
            "properties": {
              "role_id": { "type": "string", "minLength": 1 },
              "runtime_thread_id": { "type": "string", "minLength": 1 },
              "source_host_id": { "const": "local" },
              "source_title": { "type": "string", "minLength": 1 },
              "observed_at": { "type": "string", "minLength": 1 },
              "activity": { "enum": ["active", "idle", "notLoaded", "UNKNOWN"] },
              "activity_evidence": { "const": "SUPPORTED_TASK_THREAD_STATUS" },
              "pin_state": { "const": "UNKNOWN" },
              "pin_capability": { "const": "UNSUPPORTED" }
            }
          }
        }
      }
    }
  }
}
