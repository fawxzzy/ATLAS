{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.cortex.receipt-interpretation.v1.json",
  "title": "ATLAS Cortex receipt interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "generated_at",
    "authority_level",
    "stack_root",
    "interpretation_id",
    "next_recommended_lane",
    "authority",
    "artifact_inputs",
    "receipt_observations",
    "interpreted_proof_summary",
    "interpretation_checks",
    "interpretation_result",
    "authority_guards",
    "boundary_reminders",
    "source_refs"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.cortex.receipt-interpretation.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_level": {
      "type": "string",
      "const": "read_only_interpretation"
    },
    "stack_root": {
      "type": "string",
      "minLength": 1
    },
    "interpretation_id": {
      "type": "string",
      "minLength": 1
    },
    "next_recommended_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "owner_layer", "rationale"],
      "properties": {
        "lane_id": { "type": "string", "minLength": 1 },
        "owner_layer": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation_authorized",
        "final_receipt_authorized",
        "approval_authorized",
        "execution_authorized",
        "dispatch_authorized",
        "owner_truth_mutation_authorized",
        "lifeline_truth_mutation_authorized",
        "transcript_scraping_allowed"
      ],
      "properties": {
        "interpretation_authorized": { "type": "boolean", "const": true },
        "final_receipt_authorized": { "type": "boolean", "const": false },
        "approval_authorized": { "type": "boolean", "const": false },
        "execution_authorized": { "type": "boolean", "const": false },
        "dispatch_authorized": { "type": "boolean", "const": false },
        "owner_truth_mutation_authorized": { "type": "boolean", "const": false },
        "lifeline_truth_mutation_authorized": { "type": "boolean", "const": false },
        "transcript_scraping_allowed": { "type": "boolean", "const": false }
      }
    },
    "artifact_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact_input" }
    },
    "receipt_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/receipt_observation" }
    },
    "interpreted_proof_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "what_changed",
        "what_proved",
        "what_remains_blocked",
        "receipt_authority_summary"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "proof_ready",
            "proof_blocked",
            "no_receipt_artifacts",
            "receipt_candidate_observed",
            "final_receipt_observed"
          ]
        },
        "what_changed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_proved": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_remains_blocked": {
          "type": "array",
          "items": { "type": "string" }
        },
        "receipt_authority_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "interpretation_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "interpretation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ready_for_stack_consumer", "blocked_reason", "failed_checks"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ready", "blocked"]
        },
        "ready_for_stack_consumer": { "type": "boolean" },
        "blocked_reason": {
          "type": ["string", "null"]
        },
        "failed_checks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "authority_guards": {
      "type": "array",
      "items": { "type": "string" }
    },
    "boundary_reminders": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "contract_version", "digest"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:"
        }
      }
    },
    "receipt_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "contract_version", "digest", "summary"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:"
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "summary"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "source_ref": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
