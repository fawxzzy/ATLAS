{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas.operator-notification.ack.v1.json",
  "title": "Atlas Operator Notification Acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "ack_id",
    "event_id",
    "source_thread_id",
    "event_class",
    "canonical_payload_digest",
    "claim_generation",
    "acknowledged_at",
    "delivery_state",
    "ack_disposition",
    "retry_authorized",
    "operator_message_authorized",
    "authority"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.operator-notification.ack.v1"
    },
    "ack_id": {
      "type": "string",
      "pattern": "^ona1_[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^onv1_[0-9a-f]{64}$"
    },
    "source_thread_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "event_class": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "canonical_payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_generation": {
      "type": "integer",
      "minimum": 1
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "delivery_state": {
      "const": "accepted"
    },
    "ack_disposition": {
      "enum": ["accepted", "replayed"]
    },
    "retry_authorized": {
      "const": false
    },
    "operator_message_authorized": {
      "const": false
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_only",
        "repository_execution_authorized",
        "board_mutation_authorized"
      ],
      "properties": {
        "notification_only": {"const": true},
        "repository_execution_authorized": {"const": false},
        "board_mutation_authorized": {"const": false}
      }
    }
  }
}
