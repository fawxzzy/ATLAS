{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.workflow.runtime-registry.v1",
  "title": "ATLAS Workflow Runtime Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_ref",
    "manifest_digest",
    "observed_at",
    "observation_precision",
    "discovery",
    "bindings",
    "unbound_runtime_claims"
  ],
  "properties": {
    "schema": { "const": "atlas.workflow.runtime-registry.v1" },
    "manifest_ref": { "type": "string", "minLength": 1 },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "observed_at": { "type": "string", "minLength": 1 },
    "observation_precision": { "enum": ["day", "second"] },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "unknown_preserved"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unknown_preserved": { "type": "boolean" }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "current_runtime_id",
          "runtime_status",
          "health",
          "archived",
          "title",
          "cwd",
          "evidence",
          "related_epochs"
        ],
        "properties": {
          "role_id": { "type": "string", "minLength": 1 },
          "current_runtime_id": { "type": ["string", "null"] },
          "runtime_status": { "type": "string", "minLength": 1 },
          "health": {
            "enum": ["HEALTHY", "DEGRADED", "MISSING", "DUPLICATE", "BLOCKED", "HELD", "UNKNOWN"]
          },
          "archived": { "type": ["boolean", "null"] },
          "title": { "type": ["string", "null"] },
          "cwd": { "type": ["string", "null"] },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "related_epochs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runtime_id", "relationship", "status"],
              "properties": {
                "runtime_id": { "type": "string", "minLength": 1 },
                "relationship": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "unbound_runtime_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtime_id",
          "title",
          "observed_status",
          "standing_contract_claim",
          "admission_state",
          "disposition",
          "canonical_target_id",
          "health",
          "recovery_action",
          "lifecycle_action_authorized",
          "evidence",
          "rationale"
        ],
        "properties": {
          "runtime_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "observed_status": { "type": "string", "minLength": 1 },
          "standing_contract_claim": { "type": "boolean" },
          "admission_state": {
            "enum": ["DURABLY_ADMITTED", "NOT_DURABLY_ADMITTED", "UNKNOWN"]
          },
          "disposition": {
            "enum": [
              "RELATED_PREDECESSOR_CLAIM",
              "EMBEDDED_COORDINATION_RUNTIME",
              "HISTORICAL_PROGRAM_SURFACE",
              "BOUNDED_RUNTIME",
              "UNKNOWN"
            ]
          },
          "canonical_target_id": { "type": ["string", "null"] },
          "health": {
            "enum": ["HEALTHY", "DEGRADED", "MISSING", "DUPLICATE", "BLOCKED", "HELD", "UNKNOWN"]
          },
          "recovery_action": {
            "enum": ["HOLD_NO_CREATE", "IGNORE_FOR_ROLE_CREATION", "MANUAL_RECONCILE"]
          },
          "lifecycle_action_authorized": { "type": "boolean" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
