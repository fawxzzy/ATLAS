{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.attention.item.v1.json",
  "title": "ATLAS attention item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "attention_id",
    "kind",
    "severity",
    "summary",
    "status",
    "source_ref",
    "observation_ids",
    "details"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.attention.item.v1"
    },
    "attention_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "details": {
      "type": "object"
    }
  }
}
