{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.machine-action-proposal.v1.json",
  "title": "ATLAS machine action proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "proposal_id",
    "target_machine_id",
    "desired_state_id",
    "policy_id",
    "created_at_utc",
    "authority_level",
    "action_kind",
    "status",
    "execution_boundary",
    "summary",
    "rationale",
    "preconditions",
    "risk_flags"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.machine-action-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^mapr_[0-9a-f]{64}$"
    },
    "target_machine_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "desired_state_id": {
      "type": "string",
      "pattern": "^mdes_[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^mpol_[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "authority_level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "action_kind": {
      "enum": [
        "REPORT_ONLY",
        "QUARANTINE",
        "RESTORE",
        "INSTALL",
        "UPGRADE",
        "UNINSTALL",
        "REPAIR",
        "CONFIGURE_STARTUP",
        "CONFIGURE_SERVICE",
        "CONFIGURE_TASK",
        "SECURITY_CHANGE"
      ]
    },
    "status": {
      "const": "PROPOSED_ONLY"
    },
    "execution_boundary": {
      "const": "LIFELINE_REQUIRED"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "risk_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destructive",
        "elevation_required",
        "network_required",
        "protected_zone_impact"
      ],
      "properties": {
        "destructive": {
          "type": "boolean"
        },
        "elevation_required": {
          "type": "boolean"
        },
        "network_required": {
          "type": "boolean"
        },
        "protected_zone_impact": {
          "type": "boolean"
        }
      }
    }
  }
}
