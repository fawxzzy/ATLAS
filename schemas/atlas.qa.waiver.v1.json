{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.qa.waiver.v1.json",
  "title": "ATLAS QA waiver v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "waiver_id",
    "repo_id",
    "scenario_id",
    "run_id",
    "waived_lane",
    "reason",
    "operator",
    "created_at",
    "expires_at",
    "evidence_present",
    "limitation"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.qa.waiver.v1"
    },
    "waiver_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "waived_lane": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "operator_identity": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_present": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
