{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas.cortex.simulation.recommendation-evaluation-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evaluation_id", "generated_at", "cases"],
  "properties": {
    "contract_version": {"const": "atlas.cortex.simulation.recommendation-evaluation-manifest.v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "simulator_manifest_ref", "simulator_manifest_digest", "expected_envelope_id", "expected_classification"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "simulator_manifest_ref": {"type": "string", "pattern": "^data/cortex/simulation-replays/.+\\.json$"},
          "simulator_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "expected_envelope_id": {"type": ["string", "null"]},
          "expected_classification": {"enum": ["match", "changed", "invalid"]}
        }
      }
    }
  }
}
