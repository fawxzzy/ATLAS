{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.session.mode.registry.v1.json",
  "title": "ATLAS session mode registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "published_refs",
    "modes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "atlas.session.mode.registry.v1"
    },
    "kind": {
      "type": "string",
      "const": "atlas-session-mode-registry"
    },
    "published_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "repo_inventory"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repo_inventory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode_id",
          "display_name",
          "status",
          "description",
          "aliases",
          "inputs",
          "repo_resolution",
          "resolves_to",
          "expected_first_response",
          "expected_patch_response"
        ],
        "properties": {
          "mode_id": {
            "type": "string",
            "minLength": 3,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled",
              "experimental"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "required",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "repo_resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inventory_ref",
              "match_order"
            ],
            "properties": {
              "inventory_ref": {
                "type": "string",
                "minLength": 1
              },
              "match_order": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "logical_id",
                    "local_path",
                    "local_path_basename",
                    "explicit_path"
                  ]
                }
              }
            }
          },
          "resolves_to": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow_doc",
              "prompt_doc",
              "startup_rules",
              "default_validation_mode",
              "default_localhost_assumption",
              "default_patch_style"
            ],
            "properties": {
              "workflow_doc": {
                "type": "string",
                "minLength": 1
              },
              "prompt_doc": {
                "type": "string",
                "minLength": 1
              },
              "startup_rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "default_validation_mode": {
                "type": "string",
                "minLength": 1
              },
              "default_localhost_assumption": {
                "type": "string",
                "minLength": 1
              },
              "default_patch_style": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "expected_first_response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields",
              "template"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "template": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "expected_patch_response": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
