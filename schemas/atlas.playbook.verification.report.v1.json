{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.playbook.verification.report.v1.json",
  "title": "ATLAS Playbook Verification Report v1",
  "description": "Repo-owned verification evidence that allows ATLAS root to distinguish adopted from verified without creating a second truth store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "generated_at",
    "repo",
    "summary",
    "scope",
    "criteria",
    "evidence_refs"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repo_identity"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_identity": {
          "enum": [
            "remote",
            "local_only",
            "unknown"
          ]
        },
        "repo_path": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_status",
        "verification_status",
        "blocking_gaps"
      ],
      "properties": {
        "adoption_status": {
          "enum": [
            "unassessed",
            "planned",
            "partial",
            "adopted",
            "verified",
            "exception"
          ]
        },
        "verification_status": {
          "enum": [
            "missing",
            "partial",
            "blocked",
            "verified",
            "unknown"
          ]
        },
        "blocking_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_kind",
        "covered_surfaces",
        "notes"
      ],
      "properties": {
        "verification_kind": {
          "enum": [
            "targeted",
            "full",
            "exception_documented"
          ]
        },
        "covered_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_export",
        "adoption_test",
        "verification_path"
      ],
      "properties": {
        "adoption_export": {
          "$ref": "#/$defs/criterion"
        },
        "adoption_test": {
          "$ref": "#/$defs/criterion"
        },
        "verification_path": {
          "$ref": "#/$defs/verification_path_criterion"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "missing"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification_path_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commands"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "missing"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
