{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.worker.merge-request.v1.json",
  "title": "ATLAS worker merge request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "merge_request_id",
    "stack_lock_digest",
    "tool_id",
    "extension_id",
    "registry_digest",
    "conflicting_workers",
    "overlaps",
    "paused_handoff_refs",
    "merge_worker_handoff"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.worker.merge-request.v1"
    },
    "merge_request_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "stack_lock_digest": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "extension_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry_digest": {
      "type": "string",
      "minLength": 1
    },
    "conflicting_workers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo_path",
          "path",
          "overlap_type",
          "reason"
        ],
        "properties": {
          "repo_path": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "overlap_type": {
            "type": "string",
            "enum": [
              "line_overlap",
              "file_digest_drift",
              "forbidden_scope"
            ]
          },
          "file_digest_before": {
            "type": "string",
            "minLength": 1
          },
          "conflicting_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "worker_id",
                "start_line",
                "end_line",
                "op"
              ],
              "properties": {
                "worker_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "op": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "paused_handoff_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "merge_worker_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "assignment_id",
        "task_id",
        "handoff_ref",
        "tool_id",
        "extension_id",
        "registry_digest"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 3
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "extension_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
