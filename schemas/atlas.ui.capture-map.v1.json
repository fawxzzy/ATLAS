{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.ui.capture-map.v1.json",
  "title": "ATLAS UI capture map v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "owner_repo_id",
    "owner_repo_path",
    "captures"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.ui.capture-map.v1"
    },
    "owner_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_repo_path": {
      "type": "string",
      "minLength": 1
    },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capture_id",
          "screen_key",
          "screen_label",
          "state_key",
          "state_label",
          "route_family",
          "owner_surface_refs",
          "primitive_variants"
        ],
        "properties": {
          "capture_id": {
            "type": "string",
            "minLength": 1
          },
          "screen_key": {
            "type": "string",
            "minLength": 1
          },
          "screen_label": {
            "type": "string",
            "minLength": 1
          },
          "state_key": {
            "type": "string",
            "minLength": 1
          },
          "state_label": {
            "type": "string",
            "minLength": 1
          },
          "route_family": {
            "type": "string",
            "minLength": 1
          },
          "owner_surface_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primitive_variants": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "header",
              "card",
              "tag",
              "section_layout"
            ],
            "properties": {
              "header": {
                "$ref": "#/$defs/primitiveSelection"
              },
              "card": {
                "$ref": "#/$defs/primitiveSelection"
              },
              "tag": {
                "$ref": "#/$defs/primitiveSelection"
              },
              "section_layout": {
                "$ref": "#/$defs/primitiveSelection"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "primitiveSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_id",
        "variant_id"
      ],
      "properties": {
        "primitive_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
