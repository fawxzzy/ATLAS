{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.program-admission.v1.json",
  "title": "ATLAS governed program admission v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "admission_id",
    "generated_at",
    "title",
    "owner",
    "authority",
    "scope",
    "dependencies",
    "serialization",
    "approval_gates",
    "evidence",
    "definition_of_done",
    "status",
    "next_packet",
    "measurement_status",
    "source_import"
  ],
  "properties": {
    "schema": {"const": "atlas.program-admission.v1"},
    "admission_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "authority": {"type": "object", "minProperties": 1},
    "scope": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "serialization": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"type": "string", "minLength": 1},
    "next_packet": {"type": "string", "minLength": 1},
    "measurement_status": {"const": "UNMEASURED"},
    "source_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stored_ref", "manifest_ref", "byte_length", "sha256"],
      "properties": {
        "stored_ref": {"type": "string", "minLength": 1},
        "manifest_ref": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
