{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.qa.test_evidence.v1.json",
  "title": "ATLAS QA test evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "scenario_id",
    "adapter_id",
    "repo_id",
    "git_sha",
    "mode",
    "receipts"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.qa.test_evidence.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "git_sha": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry_run",
        "execute"
      ]
    },
    "receipts": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    }
  }
}
