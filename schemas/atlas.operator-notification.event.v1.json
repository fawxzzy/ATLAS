{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas.operator-notification.event.v1.json",
  "title": "Atlas Operator Notification Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "source_thread_id",
    "event_class",
    "notification_kind",
    "canonicalization",
    "canonical_payload_digest",
    "transport_envelope_digest",
    "created_at",
    "supersedes_event_id",
    "delta",
    "payload",
    "authority"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.operator-notification.event.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^onv1_[0-9a-f]{64}$"
    },
    "source_thread_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "event_class": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "notification_kind": {
      "enum": [
        "operator_update",
        "periodic_digest",
        "heartbeat",
        "continuation"
      ]
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "digest_algorithm",
        "included_paths",
        "excluded_paths"
      ],
      "properties": {
        "contract_version": {
          "const": "atlas.operator-notification.canonical-json.v1"
        },
        "digest_algorithm": {
          "const": "sha256"
        },
        "included_paths": {
          "const": ["$.payload.facts"]
        },
        "excluded_paths": {
          "const": ["$.payload.transport", "$.created_at"]
        }
      }
    },
    "canonical_payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "transport_envelope_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_event_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^onv1_[0-9a-f]{64}$"}
      ]
    },
    "delta": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/delta"}
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "transport"],
      "properties": {
        "facts": {
          "type": "object",
          "minProperties": 1
        },
        "transport": {
          "type": "object"
        }
      }
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_fact_paths"],
      "properties": {
        "changed_fact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notification_only",
        "repository_execution_authorized",
        "board_mutation_authorized"
      ],
      "properties": {
        "notification_only": {"const": true},
        "repository_execution_authorized": {"const": false},
        "board_mutation_authorized": {"const": false}
      }
    }
  }
}
