{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.master-program-register.v1.json",
  "title": "ATLAS master program register v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generated_at",
    "title",
    "register_scope",
    "producer",
    "source_refs",
    "authority_model",
    "measurement_policy",
    "approval_gate_catalog",
    "global_holds",
    "programs",
    "provenance_guards",
    "authority_indexes"
  ],
  "properties": {
    "schema": {"const": "atlas.master-program-register.v1"},
    "version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "register_scope": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "command", "check"],
      "properties": {
        "source": {"const": "docs/programs/ATLAS-MASTER-PROGRAM-REGISTER.v1.source.json"},
        "command": {"const": "python ops/atlas/master_program.py --write"},
        "check": {"const": "python ops/atlas/master_program.py --check"}
      }
    },
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_model": {"type": "object", "minProperties": 1},
    "measurement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_work", "percentage_rule", "decomposition_rule"],
      "properties": {
        "new_work": {"const": "UNMEASURED"},
        "percentage_rule": {"type": "string", "minLength": 1},
        "decomposition_rule": {"type": "string", "minLength": 1}
      }
    },
    "approval_gate_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "global_holds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "rule"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "owner", "authority", "scope", "dependencies", "serialization", "approval_gates", "evidence", "definition_of_done", "status", "next_packet", "measurement_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "serialization": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "approval_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "minLength": 1},
          "next_packet": {"type": "string", "minLength": 1},
          "measurement_status": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance_guards": {"type": "object", "minProperties": 1},
    "authority_indexes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean_and_resync_lane_registry", "mandatory_closing_audit"],
      "properties": {
        "clean_and_resync_lane_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_ref", "lane_ids", "backlog_ids", "status_rule"],
          "properties": {
            "authority_ref": {"const": "docs/registry/ATLAS-FULL-SYSTEM-REEVALUATION-LANES.json"},
            "lane_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "backlog_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "status_rule": {"type": "string", "minLength": 1}
          }
        },
        "mandatory_closing_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_ref", "marker_authority_ref", "status", "accepted_opening_gate_count", "fixed_gate_denominator", "historical_percentage", "rule"],
          "properties": {
            "authority_ref": {"type": "string", "minLength": 1},
            "marker_authority_ref": {"type": "string", "minLength": 1},
            "status": {"const": "pending"},
            "accepted_opening_gate_count": {"const": 1},
            "fixed_gate_denominator": {"const": 2},
            "historical_percentage": {"const": 50},
            "rule": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
