{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.cortex.simulation.receipt-replay-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scenario_id", "agent_id", "generated_at", "objective", "receipts"],
  "properties": {
    "contract_version": {"const": "atlas.cortex.simulation.receipt-replay-manifest.v1"},
    "scenario_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "objective": {"type": "string", "minLength": 1},
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "digest", "trust_class"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "trust_class": {"enum": ["atlas_runtime_receipt", "committed_replay_fixture", "contract_fixture"]}
        }
      }
    }
  }
}
