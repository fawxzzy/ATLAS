{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.tool.catalog.entry.v1.json",
  "title": "ATLAS tool catalog entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tool_id",
    "display_name",
    "description",
    "surface_kind",
    "status",
    "owner",
    "extension_id",
    "trust_class",
    "release_eligible",
    "executor",
    "contracts",
    "invocation",
    "capability_profile",
    "approval"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.tool.catalog.entry.v1"
    },
    "tool_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "surface_kind": {
      "type": "string",
      "enum": [
        "builtin",
        "extension"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "experimental"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "extension_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "trusted",
        "adjacent",
        "untrusted"
      ]
    },
    "release_eligible": {
      "type": "boolean"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "entrypoint",
        "mode"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "runtime",
            "subprocess"
          ]
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "receipt"
      ],
      "properties": {
        "request": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "action_operation",
        "execution_mode"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "execution",
            "coordination"
          ]
        },
        "action_operation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "read_only_scan",
            "scoped_write",
            null
          ]
        },
        "execution_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "read_only_scan",
            "dry_run_command",
            null
          ]
        }
      }
    },
    "capability_profile": {
      "$ref": "atlas://schemas/atlas.capability.profile.v1.json"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "approver_kind",
        "required_status",
        "granted_scope_required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approver_kind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "system",
            "human",
            null
          ]
        },
        "required_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "approved",
            null
          ]
        },
        "granted_scope_required": {
          "type": "boolean"
        }
      }
    }
  }
}
