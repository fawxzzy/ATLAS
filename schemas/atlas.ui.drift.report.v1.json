{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.ui.drift.report.v1.json",
  "title": "ATLAS UI drift report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "report_id",
    "generated_at",
    "owner_repo_id",
    "owner_contract_refs",
    "capture_map_ref",
    "summary",
    "findings",
    "operator_summary"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.ui.drift.report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_repo_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_contract_refs": {
      "type": "object"
    },
    "capture_map_ref": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expected_capture_count",
        "observed_capture_count",
        "finding_count",
        "mismatch_count",
        "missing_count",
        "unexpected_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "clean",
            "drift_detected"
          ]
        },
        "expected_capture_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_capture_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "unexpected_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "kind",
          "severity",
          "comparison_key",
          "capture_id",
          "message"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "minLength": 1
          },
          "comparison_key": {
            "type": "string",
            "minLength": 1
          },
          "capture_id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "observed": {},
          "delta": {}
        }
      }
    },
    "operator_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
