{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas.autonomous-work-program.v2",
  "title": "ATLAS Autonomous Work Program v2",
  "type": "object",
  "$defs": {
    "owner_return": {
      "type": "object",
      "required": ["logical_role_id", "thread_id", "host_id"],
      "additionalProperties": false,
      "properties": {
        "logical_role_id": { "type": "string", "minLength": 1 },
        "thread_id": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 }
      }
    },
    "legacy_owner_return": {
      "type": "object",
      "required": ["logical_role_id", "thread_id", "delivery_order"],
      "additionalProperties": false,
      "properties": {
        "logical_role_id": { "type": "string", "minLength": 1 },
        "thread_id": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 },
        "delivery_order": {
          "enum": [
            "OWNER_FIRST",
            "OWNER_FIRST_ALREADY_COMPLETED",
            "OWNER_FIRST_DIRECT",
            "OWNER_FIRST_THEN_00_MAIN",
            "OWNER_FIRST_THEN_ATLAS_MAIN",
            "OWNER_FIRST_THEN_MAIN_SETTLEMENT",
            "PRIMARY_ONLY",
            "PRIMARY_ONLY_AFTER_OWNER_TERMINAL_RECEIPT"
          ]
        }
      }
    },
    "execution_target": {
      "type": "object",
      "required": ["logical_role_id", "thread_id", "host_id"],
      "additionalProperties": false,
      "properties": {
        "logical_role_id": { "type": "string", "minLength": 1 },
        "thread_id": { "type": "string", "minLength": 1 },
        "host_id": { "type": "string", "minLength": 1 }
      }
    },
    "resource_claims": {
      "type": "object",
      "required": ["files", "worktrees", "ports", "browsers", "external_writers"],
      "additionalProperties": false,
      "properties": {
        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "worktrees": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ports": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "browsers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "external_writers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authorization_event_digest": {
      "type": "object",
      "required": ["event_id", "payload_digest"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" },
        "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "external_attempt_authority": {
      "type": "object",
      "required": [
        "attempt_id",
        "limit",
        "expected_consumed_count",
        "writer_scope",
        "repository",
        "external_resource_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "limit": { "const": 1 },
        "expected_consumed_count": { "const": 0 },
        "writer_scope": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "external_resource_identity": { "type": "string", "minLength": 1 }
      }
    },
    "external_attempt_claim": {
      "type": "object",
      "required": [
        "attempt_id",
        "limit",
        "expected_consumed_count",
        "authorization_event_digest",
        "writer_scope",
        "repository",
        "external_resource_identity"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "limit": { "const": 1 },
        "expected_consumed_count": { "const": 0 },
        "authorization_event_digest": { "$ref": "#/$defs/authorization_event_digest" },
        "writer_scope": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "external_resource_identity": { "type": "string", "minLength": 1 }
      }
    },
    "external_attempt_record": {
      "type": "object",
      "required": [
        "attempt_id",
        "limit",
        "consumed_count",
        "authorization_event_digest",
        "authorization_source_role_id",
        "authorization_kind",
        "authorization_scope",
        "writer_scope",
        "repository",
        "external_resource_identity",
        "packet_id",
        "idempotency_key",
        "reservation_id",
        "status",
        "consumed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "limit": { "const": 1 },
        "consumed_count": { "const": 1 },
        "authorization_event_digest": { "$ref": "#/$defs/authorization_event_digest" },
        "authorization_source_role_id": { "const": "fawxzzy.authorization" },
        "authorization_kind": { "enum": ["OPERATOR_DECISION", "OPERATOR_DECISION_ANSWER"] },
        "authorization_scope": { "$ref": "#/$defs/external_attempt_authority" },
        "writer_scope": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "external_resource_identity": { "type": "string", "minLength": 1 },
        "packet_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "reservation_id": { "type": "string", "pattern": "^rsrv_[0-9a-f]{64}$" },
        "status": { "const": "consumed" },
        "consumed_at": { "type": "string", "minLength": 1 }
      }
    },
    "source_preparation": {
      "type": "object",
      "required": ["mode", "publication", "parent_commit", "path_allowlist"],
      "properties": {
        "mode": { "const": "LOCAL_ONLY_UNSTAGED" },
        "publication": { "const": "HELD" },
        "parent_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path_allowlist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "legacy_event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Z0-9][A-Z0-9_-]*:ANSWER$"
    },
    "terminal_successor": {
      "enum": [
        "NEXT_AUTONOMOUS_PACKET",
        "MANUAL_REQUIRED",
        "EXTERNAL_WAIT",
        "TERMINAL_DOMAIN",
        "ERROR_RECOVERY"
      ]
    }
  },
  "required": [
    "schema_version",
    "revision",
    "source_snapshot_digest",
    "scheduler_authority",
    "standing_packets",
    "active_leases",
    "scope_holds",
    "delivery_intents",
    "completed_packets",
    "completed_receipts",
    "released_leases",
    "processed_events"
  ],
  "properties": {
    "schema_version": { "const": "atlas.autonomous-work-program.v2" },
    "revision": { "type": "integer", "minimum": 1 },
    "source_snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "scheduler_authority": {
      "const": {
        "logical_role_id": "atlas.workflow-operations",
        "mode": "SELECTOR_SUPERVISOR",
        "control_loop": "ops/atlas/autonomous_lane_scheduler.py",
        "release_role": "atlas.release-control-plane",
        "architecture_role": "atlas.workflow-architect"
      }
    },
    "max_parallel_writers": { "type": "integer", "minimum": 0 },
    "max_parallel_read_only": { "type": "integer", "minimum": 0 },
    "standing_packets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packet_id",
          "packet",
          "state",
          "logical_role_id",
          "repository",
          "writer_scope",
          "execution_class",
          "runtime_thread_id",
          "runtime_status",
          "authority"
        ],
        "properties": {
          "packet_id": { "type": "string", "minLength": 1 },
          "packet": { "type": "string", "minLength": 1 },
          "state": { "enum": ["READY", "ADMITTED", "QUEUED", "ACTIVE", "BLOCKED", "RECOVERY_READY", "HOST_UNAVAILABLE", "SUPERSEDED"] },
          "logical_role_id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "writer_scope": { "type": "string", "minLength": 1 },
          "execution_class": { "enum": ["read_only", "repo_worktree", "canonical_workspace", "external_mutation"] },
          "runtime_thread_id": { "type": ["string", "null"] },
          "runtime_status": { "type": "string", "minLength": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "resource_claims": { "$ref": "#/$defs/resource_claims" },
          "external_attempt": { "$ref": "#/$defs/external_attempt_claim" },
          "policy_id": { "type": ["string", "null"] },
          "policy_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "target_role_id": { "type": ["string", "null"] },
          "host_id": { "type": ["string", "null"] },
          "execution_target": { "anyOf": [{ "$ref": "#/$defs/execution_target" }, { "type": "null" }] },
          "execution_target_state": { "enum": ["PENDING", "DELIVERED", "HOST_UNAVAILABLE", "UNKNOWN"] },
          "owner_return": { "anyOf": [{ "$ref": "#/$defs/owner_return" }, { "type": "null" }] },
          "owner_return_state": {
            "enum": ["LEGACY_UNPROVEN", "PENDING", "PENDING_REDELIVERY", "DELIVERED", "OWNER_RETURN_BLOCKED", "UNKNOWN"]
          },
          "owner_return_turn_id": { "type": ["string", "null"] },
          "owner_return_proof": { "type": ["object", "null"] },
          "current_tracker_role_id": { "type": ["string", "null"] },
          "protected_surface_authorized": { "type": "boolean" },
          "authority_class": { "enum": [null, "standing_local_source_preparation"] },
          "source_role_id": { "type": "string", "minLength": 1 },
          "source_preparation": {
            "anyOf": [
              { "$ref": "#/$defs/source_preparation" },
              { "type": "null" }
            ]
          },
          "authority": {
            "type": "object",
            "required": ["event_id", "payload_digest"],
            "properties": {
              "event_id": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" },
              "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "transport_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "dispatch_reservation": { "type": "object" }
        },
        "allOf": [
          {
            "if": { "required": ["external_attempt"] },
            "then": {
              "required": ["protected_surface_authorized"],
              "properties": {
                "execution_class": { "const": "external_mutation" },
                "protected_surface_authorized": { "const": true }
              }
            }
          },
          {
            "if": {
              "required": ["authority_class"],
              "properties": {
                "authority_class": { "const": "standing_local_source_preparation" }
              }
            },
            "then": {
              "required": ["source_role_id", "source_preparation"],
              "properties": {
                "source_preparation": { "$ref": "#/$defs/source_preparation" }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "required": ["policy_id"],
                  "properties": {
                    "policy_id": { "const": "ATLAS-WORKFLOW-STANDARDIZATION-20260721-001" }
                  }
                },
                {
                  "required": ["policy_ids"],
                  "properties": {
                    "policy_ids": {
                      "contains": { "const": "ATLAS-WORKFLOW-STANDARDIZATION-20260721-001" }
                    }
                  }
                }
              ]
            },
            "then": {
              "required": ["target_role_id", "execution_target", "owner_return", "owner_return_state"]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "active_leases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reservation_id",
          "packet_id",
          "writer_scope",
          "repository",
          "execution_class",
          "resource_claims",
          "status"
        ],
        "properties": {
          "reservation_id": { "type": "string", "pattern": "^rsrv_[0-9a-f]{64}$" },
          "packet_id": { "type": "string", "minLength": 1 },
          "writer_scope": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "execution_class": { "enum": ["repo_worktree", "canonical_workspace", "external_mutation"] },
          "resource_claims": { "$ref": "#/$defs/resource_claims" },
          "external_attempt_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "recovery-required"] }
        },
        "additionalProperties": true
      }
    },
    "scope_holds": { "type": "array", "items": { "type": "object" } },
    "delivery_intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reservation_id",
          "packet_id",
          "logical_role_id",
          "runtime_thread_id",
          "writer_scope",
          "event_id",
          "payload_digest",
          "status"
        ],
        "properties": {
          "reservation_id": { "type": "string", "pattern": "^rsrv_[0-9a-f]{64}$" },
          "external_attempt_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["prepared", "delivered", "host-unavailable", "recovery-required"] },
          "turn_id": { "type": ["string", "null"] },
          "transport_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "execution_target": { "anyOf": [{ "$ref": "#/$defs/execution_target" }, { "type": "null" }] },
          "execution_target_state": { "enum": ["PENDING", "DELIVERED", "HOST_UNAVAILABLE", "UNKNOWN"] },
          "owner_return": { "anyOf": [{ "$ref": "#/$defs/owner_return" }, { "type": "null" }] },
          "owner_return_state": {
            "enum": ["LEGACY_UNPROVEN", "PENDING", "PENDING_REDELIVERY", "DELIVERED", "OWNER_RETURN_BLOCKED", "UNKNOWN"]
          },
          "owner_return_turn_id": { "type": ["string", "null"] },
          "owner_return_proof": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    },
    "external_attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/external_attempt_record" }
    },
    "completed_packets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "completed_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "terminal_successor": { "type": "string" },
          "receipt_path": { "type": "string", "minLength": 1 },
          "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "oneOf": [
          {
            "not": {
              "anyOf": [
                { "required": ["receipt_path"] },
                { "required": ["receipt_sha256"] }
              ]
            },
            "properties": {
              "terminal_successor": { "$ref": "#/$defs/terminal_successor" }
            }
          },
          {
            "required": ["receipt_path", "receipt_sha256"],
            "properties": {
              "terminal_successor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "released_leases": { "type": "array", "items": { "type": "object" } },
    "processed_events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["event_id", "payload_digest"],
            "additionalProperties": false,
            "properties": {
              "event_id": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" },
              "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "transport_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "source_role_id": { "type": ["string", "null"] },
              "kind": { "type": ["string", "null"] },
              "external_attempt_authority": {
                "anyOf": [{ "$ref": "#/$defs/external_attempt_authority" }, { "type": "null" }]
              },
              "target_role_id": { "type": ["string", "null"] },
              "execution_target": { "anyOf": [{ "$ref": "#/$defs/execution_target" }, { "type": "null" }] },
              "owner_return": { "anyOf": [{ "$ref": "#/$defs/owner_return" }, { "type": "null" }] }
            }
          },
          {
            "type": "object",
            "required": ["event_id", "payload_digest", "target_role_id", "disposition"],
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "anyOf": [
                  { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" },
                  { "$ref": "#/$defs/legacy_event_id" }
                ]
              },
              "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "target_role_id": { "type": "string", "minLength": 1 },
              "execution_target": { "$ref": "#/$defs/execution_target" },
              "owner_return": { "$ref": "#/$defs/legacy_owner_return" },
              "disposition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
              },
              "source_event_id": { "type": "string", "pattern": "^onv1_[0-9a-f]{64}$" }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
