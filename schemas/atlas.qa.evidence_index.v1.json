{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.qa.evidence_index.v1.json",
  "title": "ATLAS QA evidence index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "generated_at",
    "runs"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.qa.evidence_index.v1"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array"
    },
    "adoption": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "retention": {
      "type": "object"
    }
  }
}
