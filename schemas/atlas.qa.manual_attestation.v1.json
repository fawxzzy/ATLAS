{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://schemas/atlas.qa.manual_attestation.v1.json",
  "title": "ATLAS QA manual attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "attestation_id",
    "operator",
    "operator_identity",
    "scenario_id",
    "adapter_id",
    "run_id",
    "lens_id",
    "device_model",
    "os_name",
    "os_version",
    "browser_name",
    "capture_timestamp",
    "expires_at",
    "screenshot_artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "atlas.qa.manual_attestation.v1"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "operator_identity": {
      "type": "string",
      "minLength": 1
    },
    "attestation_signature": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "device_model": {
      "type": "string",
      "minLength": 1
    },
    "os_name": {
      "type": "string",
      "minLength": 1
    },
    "os_version": {
      "type": "string",
      "minLength": 1
    },
    "browser_name": {
      "type": "string",
      "minLength": 1
    },
    "browser_version": {
      "type": "string"
    },
    "capture_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "screenshot_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_ref",
          "checksum_sha256"
        ],
        "properties": {
          "path_ref": {
            "type": "string",
            "minLength": 1
          },
          "checksum_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "supporting_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
