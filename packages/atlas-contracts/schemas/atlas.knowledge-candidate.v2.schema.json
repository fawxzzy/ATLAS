{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.knowledge-candidate.v2.schema.json",
  "title": "ATLAS knowledge candidate contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "candidate_id", "kind", "name", "statement", "scope", "provenance", "review", "suggested_destination", "created_at"],
  "properties": {
    "contract_version": {"type": "string", "const": "atlas.knowledge-candidate.v2"},
    "candidate_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["rule", "pattern", "failure-mode", "automation-opportunity", "governance-gap"]},
    "name": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "review": {"$ref": "#/$defs/review"},
    "suggested_destination": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "ref", "classification"],
      "properties": {
        "source_type": {"type": "string", "enum": ["repository", "receipt", "task", "conversation", "external-source", "operator-decision"]},
        "ref": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "enum": ["verified", "reported", "inferred", "unknown"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "decision_note"],
      "properties": {
        "status": {"type": "string", "enum": ["candidate", "accepted", "rejected", "superseded"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "decision_note": {"type": ["string", "null"]}
      }
    }
  }
}
