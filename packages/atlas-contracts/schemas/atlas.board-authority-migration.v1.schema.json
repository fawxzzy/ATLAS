{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.board-authority-migration.v1.schema.json",
  "title": "ATLAS board authority migration contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "migration_id",
    "phase",
    "v2_contract_baseline",
    "v2_authority_snapshot",
    "target_contracts",
    "one_time_import",
    "first_v3_acceptance",
    "rollback",
    "cutover",
    "full_system_audit_points",
    "historical_marker_effect",
    "created_at"
  ],
  "properties": {
    "contract_version": {"const": "atlas.board-authority-migration.v1"},
    "migration_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "enum": ["planned", "baseline-imported", "baseline-import-failed", "baseline-import-unknown", "v3-acceptance-open", "v3-active", "rolled-back-v3"]},
    "v2_contract_baseline": {"$ref": "#/$defs/contractBaseline"},
    "v2_authority_snapshot": {"$ref": "#/$defs/authoritySnapshot"},
    "target_contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "one_time_import": {"$ref": "#/$defs/import"},
    "first_v3_acceptance": {"$ref": "#/$defs/firstAcceptance"},
    "rollback": {"$ref": "#/$defs/rollback"},
    "cutover": {"$ref": "#/$defs/cutover"},
    "full_system_audit_points": {"const": 0},
    "historical_marker_effect": {"const": "none"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "contractBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "selection_rule", "file_count", "path_set_digest", "tree_digest", "protected_path_groups"],
      "properties": {
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "selection_rule": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "path_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "protected_path_groups": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "snapshot_id", "digest", "captured_at", "unknown_reason"],
      "properties": {
        "status": {"type": "string", "enum": ["available", "UNKNOWN"]},
        "snapshot_id": {"type": ["string", "null"]},
        "digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "captured_at": {"type": ["string", "null"], "format": "date-time"},
        "unknown_reason": {"type": ["string", "null"]}
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "import_id", "idempotency_key", "source_snapshot_digest", "event_sequence_start", "event_sequence_end", "imported_at", "failure_reason", "unknown_reason"],
      "properties": {
        "mode": {"const": "one-time"},
        "status": {"type": "string", "enum": ["not-started", "imported", "verified", "failed", "UNKNOWN"]},
        "import_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "source_snapshot_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "event_sequence_start": {"type": ["integer", "null"], "minimum": 1},
        "event_sequence_end": {"type": ["integer", "null"], "minimum": 1},
        "imported_at": {"type": ["string", "null"], "format": "date-time"},
        "failure_reason": {"type": ["string", "null"], "minLength": 1},
        "unknown_reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "firstAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_id", "accepted_at"],
      "properties": {
        "status": {"type": "string", "enum": ["not-accepted", "accepted"]},
        "receipt_id": {"type": ["string", "null"]},
        "accepted_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_first_v3_acceptance", "after_first_v3_acceptance", "current_mode"],
      "properties": {
        "before_first_v3_acceptance": {"const": "v2-authority-allowed"},
        "after_first_v3_acceptance": {"const": "v3-restore-replay-only"},
        "current_mode": {"type": "string", "enum": ["v2-authority-allowed", "v3-restore-replay-only"]}
      }
    },
    "cutover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gate_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["held", "ready", "active", "rolled-back-v3"]},
        "gate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
