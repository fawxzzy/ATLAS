{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.env.v1.schema.json",
  "title": "ATLAS env contract v1",
  "description": "Environment contract for an ATLAS-admitted repo or app surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repo_id",
    "app_id",
    "environment",
    "required",
    "optional",
    "forbidden",
    "public_prefixes",
    "secret_prefixes",
    "owner_repo"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.env.v1"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "app_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "preview",
        "production",
        "ci",
        "test"
      ]
    },
    "required": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/envVarSpec"
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/envVarSpec"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "public_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "secret_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "owner_repo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "envVarSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "exposure",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "exposure": {
          "type": "string",
          "enum": [
            "public",
            "secret"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "required_in": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local",
              "preview",
              "production",
              "ci",
              "test"
            ]
          }
        },
        "example": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
