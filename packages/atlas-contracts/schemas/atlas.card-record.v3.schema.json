{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.card-record.v3.schema.json",
  "title": "ATLAS authoritative card record contract v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority",
    "card_id",
    "project_id",
    "board_id",
    "epoch_id",
    "version",
    "last_event_sequence",
    "title",
    "description",
    "card_type",
    "lifecycle",
    "priority",
    "owner",
    "standing_anchor",
    "archive_state",
    "work",
    "blockers",
    "owned_resources",
    "receipt_refs",
    "next_action",
    "projection_state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "atlas.card-record.v3"},
    "authority": {"const": "atlas-local-ledger"},
    "card_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "board_id": {"type": "string", "minLength": 1},
    "epoch_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "last_event_sequence": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "card_type": {
      "type": "string",
      "enum": ["feature", "bug", "governance", "architecture", "documentation", "automation", "research", "migration", "reliability", "technical-debt"]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["intake", "planning", "ready", "in-progress", "review", "completed", "blocked", "archived"]
    },
    "priority": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", null]},
    "owner": {"type": ["string", "null"]},
    "standing_anchor": {"type": "boolean"},
    "archive_state": {"type": "string", "enum": ["active", "successor-pending", "archive-eligible", "archived"]},
    "work": {"$ref": "#/$defs/work"},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
    "owned_resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "receipt_refs": {"type": "array", "items": {"$ref": "#/$defs/receipt"}},
    "next_action": {"type": ["string", "null"]},
    "projection_state": {"type": "string", "enum": ["queued", "applied", "stale", "failed", "UNKNOWN"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "lease_id", "branch_name", "head_sha", "worktree_ref", "status"],
      "properties": {
        "job_id": {"type": ["string", "null"]},
        "lease_id": {"type": ["string", "null"]},
        "branch_name": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "worktree_ref": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["unassigned", "active", "blocked", "review", "accepted", "terminal", "UNKNOWN"]}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "status", "reason", "evidence_ref"],
      "properties": {
        "blocker_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["open", "cleared", "UNKNOWN"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "kind", "owner", "status"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["claimed", "released", "UNKNOWN"]}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "digest", "status"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"type": "string", "enum": ["succeeded", "failed", "UNKNOWN"]}
      }
    }
  }
}
