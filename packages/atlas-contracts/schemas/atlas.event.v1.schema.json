{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.event.v1.schema.json",
  "title": "ATLAS event envelope v1",
  "description": "Stable platform-level event envelope for lifecycle and application events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_type",
    "event_id",
    "occurred_at",
    "repo_id",
    "app_id",
    "environment",
    "producer",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.event.v1"
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "session_start",
            "task_start",
            "pre_command",
            "post_command",
            "validation_complete",
            "export_complete",
            "session_stop"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
        }
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "preview",
        "production",
        "ci",
        "test"
      ]
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "payload": {
      "type": "object"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wrapper",
            "native_hook",
            "git_hook",
            "ci",
            "service",
            "manual",
            "test",
            "browser",
            "worker"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "host": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "workspace_root"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "run_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_name"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "task_name": {
          "type": "string",
          "minLength": 1
        },
        "scope_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repo_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "mutation_mode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{16,32}$"
        },
        "span_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Fa-f0-9]{16}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rel",
        "href"
      ],
      "properties": {
        "rel": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
