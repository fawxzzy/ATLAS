{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.projection-ack.v1.schema.json",
  "title": "ATLAS projection acknowledgement contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "ack_id",
    "delivery_id",
    "adapter",
    "card_id",
    "project_id",
    "board_id",
    "event_id",
    "event_sequence",
    "card_version",
    "idempotency_key",
    "availability",
    "state",
    "attempt_count",
    "retryable",
    "next_attempt_at",
    "touched_card_readback",
    "acknowledged_at",
    "local_acceptance_effect"
  ],
  "properties": {
    "contract_version": {"const": "atlas.projection-ack.v1"},
    "ack_id": {"type": "string", "minLength": 1},
    "delivery_id": {"type": "string", "minLength": 1},
    "adapter": {"const": "discordos"},
    "card_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "board_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_sequence": {"type": "integer", "minimum": 1},
    "card_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "availability": {"type": "string", "enum": ["available", "unavailable"]},
    "state": {"type": "string", "enum": ["applied", "stale", "failed", "UNKNOWN"]},
    "attempt_count": {"type": "integer", "minimum": 1},
    "retryable": {"type": "boolean"},
    "next_attempt_at": {"type": ["string", "null"], "format": "date-time"},
    "touched_card_readback": {"$ref": "#/$defs/readback"},
    "error": {"type": ["object", "null"]},
    "acknowledged_at": {"type": "string", "format": "date-time"},
    "local_acceptance_effect": {"const": "none"}
  },
  "$defs": {
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "card_id", "state", "request_count", "full_scan", "observed_at", "response_digest"],
      "properties": {
        "mode": {"const": "exact-touched-card"},
        "card_id": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["applied", "stale", "failed", "UNKNOWN"]},
        "request_count": {"type": ["integer", "null"], "minimum": 0},
        "full_scan": {"const": false},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "response_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
