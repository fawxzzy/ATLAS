{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://packages/contracts/atlas.health.v1.schema.json",
  "title": "ATLAS health contract v1",
  "description": "Health payload emitted by an ATLAS-admitted repo or app surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repo_id",
    "app_id",
    "checked_at",
    "status",
    "environment",
    "version",
    "commit",
    "checks",
    "receipts"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.health.v1"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "failing",
        "unknown"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "preview",
        "production",
        "ci",
        "test"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receiptRef"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded",
            "failing",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "latency_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "passed",
            "failed",
            "skipped",
            "warning"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
