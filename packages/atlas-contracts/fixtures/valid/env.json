{
  "contract_version": "atlas.env.v1",
  "repo_id": "fitness",
  "app_id": "fawxzzy-fitness",
  "environment": "production",
  "required": [
    {
      "name": "NEXT_PUBLIC_SUPABASE_URL",
      "exposure": "public",
      "summary": "Public Supabase project URL.",
      "required_in": [
        "local",
        "preview",
        "production"
      ],
      "example": "https://example.supabase.co"
    },
    {
      "name": "SUPABASE_SERVICE_ROLE_KEY",
      "exposure": "secret",
      "summary": "Privileged server-side service key.",
      "required_in": [
        "production",
        "ci"
      ],
      "example": null
    }
  ],
  "optional": [
    {
      "name": "ATLAS_SERVICE_NAME",
      "exposure": "public",
      "summary": "Optional service label for health and traces.",
      "required_in": [
        "preview",
        "production"
      ],
      "example": "fawxzzy-fitness"
    }
  ],
  "forbidden": [
    "SUPABASE_ANON_KEY_LEGACY"
  ],
  "public_prefixes": [
    "NEXT_PUBLIC_",
    "ATLAS_PUBLIC_"
  ],
  "secret_prefixes": [
    "SUPABASE_",
    "ATLAS_SECRET_"
  ],
  "owner_repo": "fitness",
  "notes": [
    "Contracts freeze before auth adapters."
  ]
}
