{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas://codex/change_handoff.schema.json",
  "title": "ATLAS Codex change handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_id",
    "generated_at",
    "producer",
    "task_name",
    "workspace_root",
    "summary",
    "changed_files",
    "validation",
    "commit_title",
    "commit_body",
    "pr_title",
    "pr_body"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "atlas.codex.handoff.v1"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "minLength": 3
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "capture_mode"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "codex",
            "wrapper",
            "manual",
            "test"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capture_mode": {
          "type": "string",
          "enum": [
            "schema_json",
            "explicit_json_file"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "task_name": {
      "type": "string",
      "minLength": 1
    },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:).+"
    },
    "scope_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:).+"
      }
    },
    "repo_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mutation_mode": {
      "type": "string",
      "enum": [
        "read_only",
        "scoped_write",
        "stack_only"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "summary",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!file:).+"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed"
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "commands"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "status"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "not_run"
                ]
              },
              "details": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "commit_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "pattern": "^[^\\r\\n]+$"
    },
    "commit_body": {
      "type": "string",
      "minLength": 1
    },
    "pr_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]+$"
    },
    "pr_body": {
      "type": "string",
      "minLength": 1
    }
  }
}
